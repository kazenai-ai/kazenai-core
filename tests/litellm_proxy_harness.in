# Test-only open-components compatibility harness for the LiteLLM proxy tests.
# NOT a certified LiteLLM Proxy deployment, and never a KazenAI dependency.
#
# `litellm[proxy]` would also install BerriAI's proprietary `litellm-enterprise`
# (production use requires a BerriAI agreement). This harness lists the proxy
# extra's requirements explicitly WITHOUT litellm-enterprise; the proxy imports
# it optionally. Opt in with KAZENAI_LITELLM_PROXY_TESTS=1.
#
# Regenerate (hash-locked, installed with --require-hashes --no-deps):
#   uv pip compile tests/litellm_proxy_harness.in --universal --python-version 3.11 \
#     --generate-hashes -o tests/litellm_proxy_harness.lock
litellm==1.104.2
litellm-proxy-extras==0.4.102.post1
