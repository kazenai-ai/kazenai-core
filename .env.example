# KazenAI Core — environment variables
# Copy to .env and fill in values before running

# Optional: FinOps service URL for server-side pre-call budget reservation.
# When set, kazenai-core will call POST /v1/budget/check before each LLM API call.
# If unset, only local in-process enforcement runs (fail-open).
KAZENAI_FINOPS_URL=http://localhost:8090

# API key for authenticating with the FinOps service.
# Must match a valid key accepted by kazenai-agent-finops.
KAZENAI_FINOPS_API_KEY=

# Optional: Ingest URL for emitting KazenEvents to AgentLens or a custom sink.
KAZENAI_INGEST_URL=
KAZENAI_API_KEY=
