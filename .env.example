# KazenAI Core: environment variables
# Copy to .env and fill in values before running.

# Agent FinOps URL. Setting it selects the Control lifecycle: each guarded call
# reserves in Agent FinOps before dispatch (POST /v1/budget/reserve) and settles
# after it. If FinOps cannot be reached the call is refused. Leave it unset for
# local in-process budgets only.
KAZENAI_FINOPS_URL=http://localhost:8090

# API key for Agent FinOps (an SDK key from the FinOps UI).
KAZENAI_FINOPS_API_KEY=

# Required under Control: finite and at least 1. How much of the requested-tier
# price is held against the limit when a provider bills a call at a service tier
# KazenAI has no certified price for. monitor() refuses to start without it.
KAZENAI_TIER_MISMATCH_MULTIPLIER=

# Optional: a separate event-ingest URL for run receipts or a custom sink.
KAZENAI_INGEST_URL=
KAZENAI_API_KEY=
